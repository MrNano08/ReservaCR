{
  "name": "reservacr",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "test": "npm run test -w backend",
    "test:integration": "npm run test:integration -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "admin:create": "npm run admin:create -w backend",
    "setup": "node scripts/setup.mjs",
    "test:http": "node scripts/http-smoke.mjs",
    "format": "prettier --write \"backend/src/**/*.ts\" \"backend/test/**/*.ts\" \"frontend/src/**/*.{ts,tsx,css}\"",
    "test:browser": "node scripts/browser-smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": ">=22.12"
  }
}
